# Copy to .env and fill in. The full app (frontend + API) reads these.
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=jobflow
# At least 32 random characters — encrypts the session cookie.
SESSION_SECRET=replace-with-at-least-32-random-characters

# SMTP is optional in development; required for email in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Booktend <bookings@example.com>"
